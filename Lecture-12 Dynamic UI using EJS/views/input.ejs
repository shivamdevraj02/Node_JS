<%- include('partials/head') %>

    <style>
        /* Basic beginner-friendly styling without variables */
        * { box-sizing: border-box; }
        body { margin: 0; font-family: Arial, sans-serif; background-color: #f0f2f5; }
        .container { width: 90%; max-width: 480px; margin: 40px auto; background: #ffffff; padding: 20px; border-radius: 8px; box-shadow: 0 2px 6px rgba(0,0,0,0.1); }
        h1 { margin: 0 0 12px; font-size: 18px; color: #222; }
        .form-row { margin-bottom: 12px; }
        label { display: block; font-size: 14px; color: #555; margin-bottom: 6px; }
        input[type="text"] { width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; font-size: 14px; }
        input[type="text"]:focus { outline: none; border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,0.08); }
        .actions { text-align: right; }
        input[type="submit"] { background: red; color: #fff; border: none; padding: 8px 12px; border-radius: 4px; cursor: pointer; }
        input[type="submit"]:hover { background: darkred; }
        .small { font-size: 12px; color: #666; margin-top: 8px; }
        @media (max-width: 480px) { .container { padding: 12px; margin: 20px; } }
    </style>
</head>
<body>

    <%-include('partials/nav') %>
    <div class="container">
        <h1>Enter your details</h1>
        <form action="/submit" method="post">
            <div class="form-row">
                <label for="name">Name:</label>
                <input type="text" id="name" name="name" required placeholder="Your name">
            </div>
            <div class="form-row">
                <label for="home-name">Home name:</label>
                <input type="text" id="home-name" name="Home" required placeholder="Your home name">
            </div>
            <div class="actions">
                <input type="submit" value="Submit">
            </div>
            <p class="small">We'll never share your information.</p>
        </form>
    </div>
</body>
</html>